# LINE限定お試着ルーム(/fitting-room)の設定。
# 実際の値はホスティング先の環境変数に設定し、このファイルやリポジトリには書かないでください。

# LINE Developers > LINEログインチャネル > チャネル基本設定
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 任意。LINE Developersに登録したコールバックURLと異なる場合のみ設定
# 例: https://www.puppilyhills.com/fitting-room/callback
LINE_LOGIN_REDIRECT_URI=

# 入室Cookieの署名用ランダム文字列(必須)。例: openssl rand -base64 32 で生成
FITTING_ROOM_SECRET=
